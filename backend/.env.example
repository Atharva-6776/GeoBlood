# GeoBlood Link - Backend Environment Configuration Template
# Copy this file to .env or export these variables in your terminal/system.

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/geoblood_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Security Configuration
# Minimum 256-bit secret string for HS256 HMAC signing
JWT_SECRET=GeoBloodLinkSecretKeyForJwtSigningMustBeAtLeast256BitsLong2026!
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
