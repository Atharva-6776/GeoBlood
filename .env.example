# API Configuration
# When VITE_USE_MOCK is 'true', Mock Service Worker (MSW) will intercept all /api calls in the browser.
# Set VITE_USE_MOCK to 'false' to connect to the real Java Spring Boot backend.
VITE_USE_MOCK=true

# Base URL for API requests
# When using MSW, '/api' is used directly.
# When switching to Spring Boot backend, set to 'http://localhost:8080/api'
VITE_API_BASE_URL=/api
